# ─── Mode ────────────────────────────────────────────────────────────────────
# Without METRONOME_LIVE=1 the demo runs in MOCK MODE (persisted in ./data/db.json)
# even if a token is set. With a token + METRONOME_LIVE=1 it calls the real Metronome API.
METRONOME_LIVE=0
METRONOME_API_TOKEN=
# (accepted aliases: METRONOME_API_KEY —the one metronome-setup uses— and METRONOME_BEARER_TOKEN —the SDK's—)
# METRONOME_API_KEY=
# Optional: API base URL (default https://api.metronome.com)
# METRONOME_BASE_URL=

# Local data folder (db.json). Default ./data
# DATA_DIR=./data

# Public app URL (for Stripe return URLs). Defaults to the request origin.
# APP_URL=http://localhost:3000

# ─── Support panel and API keys ──────────────────────────────────────────────
# Demo password for /admin (default: nebula-admin). Change it for any shared deployment.
# ADMIN_PASSWORD=nebula-admin
# Optional pepper for API key hashes (HMAC-SHA256 instead of plain SHA-256). Changing it invalidates existing keys.
# API_KEY_PEPPER=

# ─── Metronome IDs ───────────────────────────────────────────────────────────
# Primary source: the file generated by metronome-setup (npx tsx src/setup.ts).
# Default ../metronome-setup/metronome-ids.json. The variables below are only used
# when a value is missing from the file.
# METRONOME_IDS_FILE=../metronome-setup/metronome-ids.json
# Same format as MetronomeIds in metronome-setup/src/ids.ts. A file with "dry_run": true is rejected.
# Plan/bundle display names and the promo code list come from catalog.* in that file.
METRONOME_CREDIT_TYPE_ID=              # credit_types.EUR
METRONOME_RATE_CARD_ID=                # rate_card.id
METRONOME_METRIC_INPUT_TOKENS=         # billable_metrics.input_tokens (for /v1/usage, 30-day chart)
METRONOME_METRIC_OUTPUT_TOKENS=        # billable_metrics.output_tokens
METRONOME_METRIC_IMAGES=               # billable_metrics.images
METRONOME_PRODUCT_INPUT_TOKENS=        # products.usage.input_tokens
METRONOME_PRODUCT_OUTPUT_TOKENS=       # products.usage.output_tokens
METRONOME_PRODUCT_IMAGES=              # products.usage.images
METRONOME_PRODUCT_SUBSCRIPTION_PRO=    # products.subscription.pro
METRONOME_PRODUCT_SUBSCRIPTION_SCALE=  # products.subscription.scale
METRONOME_PRODUCT_PLAN_CREDITS=        # products.fixed.plan_credits
METRONOME_PRODUCT_BUNDLE_COMMIT=       # products.fixed.bundle_commit
METRONOME_PRODUCT_BUNDLE_BONUS=        # products.fixed.bundle_bonus
METRONOME_PRODUCT_AUTO_RECHARGE=       # products.fixed.auto_recharge
METRONOME_PRODUCT_SPEND_THRESHOLD=     # products.fixed.spend_threshold
METRONOME_PRODUCT_PROMO_CREDIT=        # products.fixed.promo_credit
METRONOME_PRODUCT_ENTERPRISE_COMMIT=   # products.fixed.enterprise_commit
# METRONOME_ZERO_BALANCE_ALERT_ID=     # alerts.zero_balance (global €0 alert, created by the setup)
# Amount scale: EUR = 1 (whole units). Only set 100 if the currency were USD (cents).
# METRONOME_AMOUNT_SCALE=1
# Auto-recharge (below €10 → top up to €50) and the Scale spend threshold (€300) are read from metronome-ids.json
# (auto_recharge.*, spend_threshold.*); without a file the catalog values (lib/catalog.ts) are used.

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Webhook secret configured in Metronome (verifies Metronome-Webhook-Signature).
# Required in live mode; in mock mode, if missing, unsigned webhooks are accepted (and flagged as such).
METRONOME_WEBHOOK_SECRET=

# Tests/demo only: 0 = in mock mode do NOT simulate the payment_gate.payment_status webhook after buying a bundle
# MOCK_AUTO_PAYMENT_WEBHOOK=1

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Only for Checkout in "setup" mode (saving the card). Metronome does the charging.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
