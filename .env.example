# ─── Modo ────────────────────────────────────────────────────────────────────
# Sin METRONOME_LIVE=1 la demo funciona en MODO SIMULADO (persistido en ./data/db.json)
# aunque haya token. Con token + METRONOME_LIVE=1 llama a la API real de Metronome.
METRONOME_LIVE=0
METRONOME_API_TOKEN=
# (alias aceptados: METRONOME_API_KEY —el de metronome-setup— y METRONOME_BEARER_TOKEN —el del SDK—)
# METRONOME_API_KEY=
# Opcional: URL base de la API (por defecto https://api.metronome.com)
# METRONOME_BASE_URL=

# Carpeta de datos locales (db.json). Por defecto ./data
# DATA_DIR=./data

# URL pública de la app (para las URLs de vuelta de Stripe). Por defecto, el origen de la petición.
# APP_URL=http://localhost:3000

# ─── IDs de Metronome ────────────────────────────────────────────────────────
# Fuente principal: el fichero que genera metronome-setup (npx tsx src/setup.ts).
# Por defecto ../metronome-setup/metronome-ids.json. Las variables de abajo solo se usan
# si falta el valor en el fichero.
# METRONOME_IDS_FILE=../metronome-setup/metronome-ids.json
# Mismo formato que MetronomeIds de metronome-setup/src/ids.ts. Un fichero con "dry_run": true se rechaza.
METRONOME_CREDIT_TYPE_ID=              # credit_types.EUR
METRONOME_RATE_CARD_ID=                # rate_card.id
METRONOME_METRIC_INPUT_TOKENS=         # billable_metrics.input_tokens (para /v1/usage, gráfico de 30 días)
METRONOME_METRIC_OUTPUT_TOKENS=        # billable_metrics.output_tokens
METRONOME_METRIC_IMAGES=               # billable_metrics.images
METRONOME_PRODUCT_INPUT_TOKENS=        # products.usage.input_tokens
METRONOME_PRODUCT_OUTPUT_TOKENS=       # products.usage.output_tokens
METRONOME_PRODUCT_IMAGES=              # products.usage.images
METRONOME_PRODUCT_SUBSCRIPTION_PRO=    # products.subscription.pro
METRONOME_PRODUCT_SUBSCRIPTION_SCALE=  # products.subscription.scale
METRONOME_PRODUCT_PLAN_CREDITS=        # products.fixed.plan_credits
METRONOME_PRODUCT_BUNDLE_COMMIT=       # products.fixed.bundle_commit
METRONOME_PRODUCT_BUNDLE_BONUS=        # products.fixed.bundle_bonus
METRONOME_PRODUCT_AUTO_RECHARGE=       # products.fixed.auto_recharge
METRONOME_PRODUCT_SPEND_THRESHOLD=     # products.fixed.spend_threshold
METRONOME_PRODUCT_PROMO_CREDIT=        # products.fixed.promo_credit
METRONOME_PRODUCT_ENTERPRISE_COMMIT=   # products.fixed.enterprise_commit
# METRONOME_ZERO_BALANCE_ALERT_ID=     # alerts.zero_balance (alerta global de 0 €, la crea el setup)
# Escala de importes: EUR = 1 (unidades enteras). Solo poner 100 si la moneda fuera USD (céntimos).
# METRONOME_AMOUNT_SCALE=1
# Umbral/recarga (10 € → hasta 50 €) y spend threshold de Scale (300 €): se leen de metronome-ids.json
# (auto_recharge.*, spend_threshold.*); sin fichero se usan los del catálogo (lib/catalog.ts).

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Secreto del webhook configurado en Metronome (verifica Metronome-Webhook-Signature).
# Obligatorio en modo en vivo; en simulado, si falta, se aceptan webhooks sin firmar (marcados como tal).
METRONOME_WEBHOOK_SECRET=

# Solo tests/demo: 0 = en modo simulado NO se simula el webhook payment_gate.payment_status tras comprar un bundle
# MOCK_AUTO_PAYMENT_WEBHOOK=1

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Solo para Checkout en modo "setup" (guardar tarjeta). Los cobros los hace Metronome.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
