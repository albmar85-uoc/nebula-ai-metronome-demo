# ─── Modo ────────────────────────────────────────────────────────────────────
# Sin METRONOME_LIVE=1 la demo funciona en MODO SIMULADO (persistido en ./data/db.json)
# aunque haya token. Con token + METRONOME_LIVE=1 llama a la API real de Metronome.
METRONOME_LIVE=0
METRONOME_API_TOKEN=
# (alias aceptado, el que usa metronome-setup)
# METRONOME_API_KEY=
# Opcional: URL base de la API (por defecto https://api.metronome.com)
# METRONOME_BASE_URL=

# Carpeta de datos locales (db.json). Por defecto ./data
# DATA_DIR=./data

# URL pública de la app (para las URLs de vuelta de Stripe). Por defecto, el origen de la petición.
# APP_URL=http://localhost:3000

# ─── IDs de Metronome ────────────────────────────────────────────────────────
# Fuente principal: el fichero que genera metronome-setup (npx tsx src/setup.ts).
# Por defecto ../metronome-setup/metronome-ids.json. Las variables de abajo solo se usan
# si falta el valor en el fichero.
# METRONOME_IDS_FILE=../metronome-setup/metronome-ids.json
METRONOME_CREDIT_TYPE_ID=            # credit_types.EUR
METRONOME_RATE_CARD_ID=              # rate_card.id
METRONOME_PRODUCT_INPUT_TOKENS=      # products.usage.input_tokens
METRONOME_PRODUCT_OUTPUT_TOKENS=     # products.usage.output_tokens
METRONOME_PRODUCT_IMAGES=            # products.usage.images
METRONOME_PRODUCT_SUBSCRIPTION_PRO=  # products.subscription.pro
METRONOME_PRODUCT_SUBSCRIPTION_SCALE= # products.subscription.scale
METRONOME_PRODUCT_RECURRING_CREDIT=  # products.fixed.plan_credits
METRONOME_PRODUCT_PREPAID_COMMIT=    # products.fixed.bundle_commit
METRONOME_PRODUCT_GIFT_CREDIT=       # products.fixed.bundle_bonus
METRONOME_PRODUCT_AUTO_RECHARGE=     # products.fixed.auto_recharge (por defecto, el del bundle)
# Tipos de evento de /v1/ingest (por defecto los del setup)
# METRONOME_EVENT_TYPE_LLM=nebula_llm_request
# METRONOME_EVENT_TYPE_IMAGES=nebula_image_generation
# Plantillas de plan como "packages" de Metronome (opcional; si existen se usan en lugar del contrato completo)
# METRONOME_PACKAGE_FREE=
# METRONOME_PACKAGE_PRO=
# METRONOME_PACKAGE_SCALE=
# Escala de importes: EUR = 1 (unidades enteras). Solo poner 100 si la moneda fuera USD (céntimos).
# METRONOME_AMOUNT_SCALE=1
# "Recargar hasta" de la recarga automática, en euros (umbral fijo 10 €). 60 ≈ commit de 50 €.
# METRONOME_RECHARGE_TO_EUR=60
# Regalo del 10 % también en la recarga automática (requiere feature flag de Metronome)
# METRONOME_THRESHOLD_DISCOUNT=0

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Secreto del webhook configurado en Metronome (verifica Metronome-Webhook-Signature).
# Obligatorio en modo en vivo; en simulado, si falta, se aceptan webhooks sin firmar (marcados como tal).
METRONOME_WEBHOOK_SECRET=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Solo para Checkout en modo "setup" (guardar tarjeta). Los cobros los hace Metronome.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
